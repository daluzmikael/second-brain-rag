# ---- Required -------------------------------------------------------------

# Your OpenAI API key. Replace this placeholder.
OPENAI_API_KEY=sk-...

# Absolute path to the Obsidian vault to index.
VAULT_PATH="~/Library/Mobile Documents/iCloud~md~obsidian/Documents/MiksVaultyBaulty"


# ---- Models ---------------------------------------------------------------

CHAT_MODEL=gpt-4o-mini

# Embeddings: "local" runs a small static model on this machine (~0.1ms per
# query, free, offline, no key needed). "openai" uses the hosted model
# (~800ms per query). Benchmarked tied for accuracy on this vault.
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=minishlab/potion-retrieval-32M

# Only used when EMBEDDING_BACKEND=openai.
EMBEDDING_MODEL=text-embedding-3-small


# ---- Optional -------------------------------------------------------------

# Vault name used for clickable obsidian:// citation links.
# Defaults to the vault folder name.
# VAULT_NAME=MiksVaultyBaulty
#
# An iCloud-synced vault lives under
#   ~/Library/Mobile Documents/iCloud~md~obsidian/Documents/<vault>
# Quote the path: it contains spaces.

# Where the local SQLite index is written.
# INDEX_PATH=data/index.sqlite3

# Web UI bind address.
# HOST=127.0.0.1
# PORT=8077

# How often the running server re-scans the vault, in seconds. Checking an
# unchanged vault costs ~0.02s (mtime and size only), so this is nearly free.
# Set to 0 to turn it off and reindex by hand.
# AUTO_REINDEX_SECONDS=30

# Retrieval tuning. Defaults suit a vault of short notes.
# TOP_K_CHUNKS=24            candidate chunks pulled from each searcher
# MAX_CONTEXT_NOTES=8        most notes handed to the model at once
# CONTEXT_TOKEN_BUDGET=7000  token ceiling for retrieved notes
# MIN_SCORE_RATIO=0.45       drop results weaker than this fraction of the best
# WEIGHT_VECTOR=1.0          semantic search weight
# WEIGHT_FTS=1.0             keyword (BM25) search weight
# WEIGHT_TITLE=1.5           note title / folder / tag match weight
# CHUNK_MAX_TOKENS=450       target chunk size

# Build the index with deterministic offline embeddings: no API key needed and
# no network calls. Keyword search still works; semantic search does not.
# Useful for testing the pipeline. Rebuild with real embeddings afterwards.
# FAKE_EMBEDDINGS=1
